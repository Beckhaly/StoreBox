# ───────────────────────────────────────────────────────────────────
# StoreBox — Variables pour docker compose (copier en infra/.env)
#   cp infra/.env.example infra/.env  puis renseigner les secrets
# ───────────────────────────────────────────────────────────────────

# ── Base de données ──
POSTGRES_DB=storebox_ci
POSTGRES_USER=storebox
POSTGRES_PASSWORD=change-me-strong-password

# ── Ports hôte (defaults choisis pour éviter les conflits locaux) ──
DB_PORT=5434        # Postgres        (host -> 5432 conteneur)
APP_PORT=8080       # App prod        (host -> 3001 conteneur)
WEB_PORT=3005       # Vite (dev)      (host -> 3000 conteneur)
API_PORT=5005       # API (dev)       (host -> 5000 conteneur)

# ── Sécurité ──
# Générer : npm run gen-secret  (min 64 caractères)
JWT_SECRET=
JWT_EXPIRES=8h
FRONTEND_URL=http://localhost:8080

# ── SMS / WhatsApp (optionnel) ──
SMS_PROVIDER=twilio
WA_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WA_FROM=whatsapp:+14155238886
GERANT_TEL=+22507000000

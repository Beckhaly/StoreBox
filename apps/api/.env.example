# ============================================================
# StoreBox — Configuration API
# Copier en .env et remplir les valeurs
# ============================================================

# Base de donnees
DATABASE_URL=postgresql://storebox:MOT_DE_PASSE@localhost:5432/storebox_db

# Serveur
PORT=3001
FRONTEND_URL=http://localhost
NODE_ENV=production

# JWT — generer avec : npm run gen-secret
JWT_SECRET=CHANGER_CE_SECRET_MINIMUM_64_CARACTERES
JWT_EXPIRES=8h

# Contacts internes
GERANT_TEL=+22507000000

# -- SMS -------------------------------------------------
# Provider : twilio | orange_ci | infobip
SMS_PROVIDER=twilio

# Twilio : https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+12025551234

# Orange SMS CI : https://developer.orange.com/apis/sms-ci
ORANGE_SMS_API_KEY=Bearer_xxxxxxxxxxxxxx
ORANGE_SENDER=StoreBox

# Infobip : https://www.infobip.com
INFOBIP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INFOBIP_BASE_URL=https://XXXXX.api.infobip.com
INFOBIP_FROM=StoreBox

# -- WHATSAPP --------------------------------------------
# Provider : twilio | infobip
WA_PROVIDER=twilio

# Twilio WhatsApp sandbox (dev)
TWILIO_WA_FROM=whatsapp:+14155238886

# Infobip WhatsApp Business
INFOBIP_WA_FROM=22507000000

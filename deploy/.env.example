# ─── Configuration client StoreBox ───
# Renseigner ces 3 valeurs, le reste est généré par install.sh.

# Domaine du client (enregistrement DNS A déjà pointé vers le serveur)
DOMAIN=client.mondomaine.com

# Secrets (laisser VIDE → générés automatiquement par install.sh)
POSTGRES_PASSWORD=
JWT_SECRET=

# Image à utiliser (par défaut : celle chargée via docker load)
STOREBOX_IMAGE=storebox-allinone:latest

# Optionnel : téléphone gérant pour les alertes
GERANT_TEL=+22507000000
